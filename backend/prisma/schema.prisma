// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  username             String               @unique
  firstName            String
  lastName             String
  password             String
  avatar               String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  ownedProjects        Project[]            @relation("ProjectOwner")
  projects             ProjectMember[]
  assignedTasks        Task[]               @relation("TaskAssignee")
  comments             Comment[]
  passwordResetTokens  PasswordResetToken[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
  @@map("users")
}

// Password Reset Token model
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Authentication Attempt model for monitoring
model AuthAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  userAgent String
  success   Boolean
  errorCode String?
  requestId String?
  timestamp DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([success])
  @@index([timestamp])
  @@index([email, timestamp])
  @@index([ipAddress, timestamp])
  @@map("auth_attempts")
}

// Suspicious Activity model for security monitoring
model SuspiciousActivity {
  id           String   @id @default(uuid())
  type         String   // 'brute_force', 'credential_stuffing', 'unusual_location', 'rapid_attempts'
  severity     String   // 'low', 'medium', 'high', 'critical'
  description  String
  ipAddress    String
  email        String?
  attemptCount Int
  timeWindow   String
  firstSeen    DateTime
  lastSeen     DateTime
  createdAt    DateTime @default(now())

  @@index([ipAddress])
  @@index([email])
  @@index([type])
  @@index([severity])
  @@index([lastSeen])
  @@index([ipAddress, lastSeen])
  @@map("suspicious_activities")
}

// Blacklisted Token model for JWT security
model BlacklistedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  tokenType String   // 'access' or 'refresh'
  expiresAt DateTime
  reason    String   // 'logout', 'password_change', 'security_breach', etc.
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([tokenType])
  @@map("blacklisted_tokens")
}

// Rate Limit Attempt model for enhanced rate limiting
model RateLimitAttempt {
  id        String   @id @default(uuid())
  key       String   // Composite key like 'ip:192.168.1.1:/auth/login' or 'email:user@example.com:/auth/login'
  timestamp DateTime @default(now())

  @@index([key])
  @@index([timestamp])
  @@index([key, timestamp])
  @@map("rate_limit_attempts")
}

// Project model
model Project {
  id          String         @id @default(uuid())
  name        String
  description String?
  color       String         @default("#0D65F2")
  ownerId     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  owner       User           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]

  @@index([ownerId])
  @@index([createdAt])
  @@map("projects")
}

// ProjectMember model (junction table)
model ProjectMember {
  id        String      @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@index([role])
  @@map("project_members")
}

// Task model
model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  projectId   String
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  assignee    User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdAt])
  @@map("tasks")
}

// Comment model
model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
  @@map("comments")
}

// Enums
enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}