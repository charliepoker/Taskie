# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5433/taskietaskie

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate secure random strings - minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_characters

# CORS
FRONTEND_URL=http://localhost:3000

# Security Configuration (Optional)
# IP Filtering - comma-separated list of IPs or CIDR ranges
IP_WHITELIST=
IP_BLACKLIST=

# Rate Limiting Overrides (Optional)
AUTH_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=100
STRICT_RATE_LIMIT_MAX=10