# Test Environment Configuration
NODE_ENV=test
PORT=3002

# Test Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/taskie_test"
DB_MAX_CONNECTIONS=5
DB_CONNECTION_TIMEOUT=5000
DB_QUERY_TIMEOUT=5000
DB_ENABLE_LOGGING=false

# Test Redis Configuration
REDIS_URL="redis://localhost:6380"
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=1
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=2000
REDIS_MAX_RETRIES=1
REDIS_MOCK_MODE=true

# JWT Configuration for tests
JWT_SECRET="test-jwt-secret-key-for-testing-only"
JWT_REFRESH_SECRET="test-jwt-refresh-secret-key-for-testing-only"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"

# Rate Limiting (disabled for tests)
DISABLE_RATE_LIMIT=true
AUTH_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_MAX=10000
STRICT_RATE_LIMIT_MAX=1000

# Security Configuration
BCRYPT_ROUNDS=4
AUDIT_LOG_ENABLED=false

# Logging Configuration
LOG_LEVEL=error
LOG_FILE=logs/test.log
LOG_MAX_SIZE=1048576
LOG_MAX_FILES=1

# Request Limits
REQUEST_SIZE_LIMIT=10mb
REQUEST_PARAMETER_LIMIT=1000